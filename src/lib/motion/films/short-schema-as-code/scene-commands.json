{
  "components": [
    { "type": "board", "id": "commands-bg" },
    {
      "type": "raw",
      "id": "chips",
      "html": "<div class='card commands-chip' style='left:890px'><b class='mono'>dbd init</b><span>new project</span></div><div class='card commands-chip' style='left:1210px'><b class='mono'>dbd inspect</b><span>see the plan</span></div><div class='card commands-chip' style='left:1530px'><b class='mono'>dbd apply</b><span>ship it</span></div>"
    },
    { "type": "wire", "id": "commands-w1", "a": [1170, 495], "c": [1190, 495], "b": [1210, 495] },
    { "type": "wire", "id": "commands-w2", "a": [1490, 495], "c": [1510, 495], "b": [1530, 495] },
    {
      "type": "head",
      "id": "commands-head",
      "at": "ground",
      "eyebrow": "dbd",
      "line": "Ordered, applied, migrated, documented.",
      "sub": "Init, inspect, apply. That is the loop.",
      "style": "left:110px;top:330px;width:720px"
    }
  ],
  "tracks": [
    { "kind": "effect", "effect": "push", "target": ".cam", "t0": 0, "dur": 6, "from": 1, "to": 1.03 },
    { "kind": "effect", "effect": "showHead", "target": ".commands-head", "t0": -0.4 },
    { "kind": "effect", "effect": "fade", "target": ".commands-chip", "count": 3, "t0": 0.8, "stagger": 0.5 },
    { "kind": "effect", "effect": "draw", "target": ".commands-w1", "t0": 1.3, "t1": 1.8 },
    { "kind": "effect", "effect": "draw", "target": ".commands-w2", "t0": 1.8, "t1": 2.3 }
  ],
  "css": ".commands-chip { top:420px; width:280px; box-sizing:border-box; padding:26px 20px; text-align:center } .commands-chip b { display:block; font-size:30px; font-weight:600; white-space:nowrap } .commands-chip span { font-size:25px; color:var(--mute) }",
  "portrait": {
    "hoist": [".commands-head"],
    "frame": [700, 920],
    "crop": [845, 375, 1010, 330],
    "css": ".commands-head{left:70px!important;top:150px!important;width:940px!important}"
  }
}
