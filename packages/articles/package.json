	"version": "0.0.0",
	"type": "module",
	"description": "The articles section, shared by sensei-hq.com and sensei-hq.org: page components, server loads, feeds, SEO. Each site passes its own config and gets its own slice of the pool in @site/content.",
	"exports": {
		"./server": "./src/server.ts",
