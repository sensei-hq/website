		"./ArticlesIndex.svelte": { "svelte": "./src/ArticlesIndex.svelte", "default": "./src/ArticlesIndex.svelte" },
		"./ArticlePage.svelte": { "svelte": "./src/ArticlePage.svelte", "default": "./src/ArticlePage.svelte" },
		"./ListPage.svelte": { "svelte": "./src/ListPage.svelte", "default": "./src/ListPage.svelte" },
		"./ShowPage.svelte": { "svelte": "./src/ShowPage.svelte", "default": "./src/ShowPage.svelte" },
		"./ArticleCard.svelte": { "svelte": "./src/ArticleCard.svelte", "default": "./src/ArticleCard.svelte" }
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test:unit": "vitest run"
	},
	"dependencies": {
		"@senseihq/emaki": "^0.8.0",
		"@senseihq/emaki-svelte": "^0.8.0",
		"@site/content": "workspace:*"
