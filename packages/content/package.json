	"version": "0.0.0",
	"type": "module",
	"description": "Shared content for sensei-hq.com and sensei-hq.org: articles, films, the product + library registry, feature claims.",
	"exports": {
		"./articles-data": "./src/articles-data.ts",
		"./article-meta": "./src/article-meta.ts",
		"./articles-server": "./src/articles-server.ts",
		"./hub-data": "./src/hub-data.ts",
