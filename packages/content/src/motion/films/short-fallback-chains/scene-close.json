  "css": ".close-card { position:absolute; left:110px; top:300px; display:flex; flex-direction:column; gap:24px; max-width:1060px } .close-title { margin:0; font-family:var(--display, serif); font-weight:400; font-size:112px; line-height:1.04; letter-spacing:-0.02em } .close-bar { width:300px; height:3px; border-radius:2px; background:var(--accent); transform-origin:0 50% } .close-card .sub { font-size:42px } .close-url { margin:0; font-size:30px; color:var(--mute) }",
