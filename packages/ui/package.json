{
	"name": "@site/ui",
	"private": true,
	"license": "UNLICENSED",
	"version": "0.0.0",
	"type": "module",
	"description": "Shared UI for sensei-hq.com and sensei-hq.org: the zen-sumi skin, tokens, brand icons, site nav.",
	"exports": {
		"./rokkit.config": "./rokkit.config.js",
		"./uno.config": "./uno.config.js",
		"./site.css": "./src/site.css",
		"./tokens.css": "./src/tokens.css",
		"./SiteNav.svelte": {
			"svelte": "./src/SiteNav.svelte",
			"default": "./src/SiteNav.svelte"
		},
		"./SiteTheme.svelte": {
			"svelte": "./src/SiteTheme.svelte",
			"default": "./src/SiteTheme.svelte"
		}
	},
	"scripts": {
		"icons:bundle": "rokkit-cli bundle -i icons -o src/icons",
		"check": "svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@rokkit/actions": "^1.15.2",
		"@rokkit/states": "^1.15.2",
		"@rokkit/themes": "^1.15.2",
		"@rokkit/ui": "^1.15.2",
		"@rokkit/unocss": "^1.15.2",
		"@unocss/reset": "^66.12.0",
		"unocss": "^66.12.0"
	},
	"peerDependencies": {
		"svelte": "^5.57.3"
	},
	"devDependencies": {
		"@rokkit/cli": "^1.15.2",
		"@types/node": "^25.9.9",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3"
	}
}
