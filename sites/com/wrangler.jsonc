// Cloudflare Pages: the site's static pages plus the worker for /admin, /api/admin and /m (see docs/posting.md).
// Bindings: DB (D1: approvals, posts, audit) and MEDIA (R2: staged videos and slides, private).
// Fill in database_id after `bunx wrangler d1 create sensei-site` (docs/posting.md, step 2).
{
  "name": "sensei-site",
  "compatibility_date": "2026-10-27",
  "pages_build_output_dir": ".svelte-kit/cloudflare",
  "d1_databases": [
    { "binding": "DB", "database_name": "sensei-site", "database_id": "38a31674-14e7-4af8-80f5-a07907240886", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "sensei-media" }]
}
