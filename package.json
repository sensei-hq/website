		"@types/d3": "^7.4.3",
		"@types/node": "^25.9.9",
		"axe-core": "^4.14.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.6",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@iconify-json/solar": "^1.2.14",
