{
	"name": "sensei-hq-website",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"workspaces": [
		"sites/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter site-com dev",
		"dev:com": "bun run --filter site-com dev",
		"dev:org": "bun run --filter site-org dev",
		"build": "bun run --filter './sites/*' build",
		"check": "bun run --filter '*' check",
		"test:unit": "bun run --filter '*' test:unit",
		"test:e2e": "bun run --filter './sites/*' test:e2e",
		"test:tools": "cd films/tools && python3 -m unittest discover -s tests",
		"test:scripts": "cd scripts && python3 -m unittest discover -s tests",
		"publish:youtube": "films/.venv/bin/python films/tools/publish.py youtube",
		"publish:instagram": "films/.venv/bin/python films/tools/publish.py instagram"
	}
}
